units metal
atom_style atomic
boundary p p p
region box block 0 20 0 20 0 20 units box
create_box 1 box
create_atoms 1 single 5.0 5.0 5.0 units box
create_atoms 1 single $(5.0+v_r) 5.0 5.0 units box
mass 1 63.546
pair_style pace product
pair_coeff * * ${model} Cu
neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes
compute atom_energy all pe/atom
compute total_atom_energy all reduce sum c_atom_energy
thermo 1
thermo_style custom step pe c_total_atom_energy
run 0
print "PACE_PROBE r=${r} pe=$(pe) atom_sum=$(c_total_atom_energy)"
