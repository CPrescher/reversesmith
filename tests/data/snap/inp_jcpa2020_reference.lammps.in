# Optional validation of the LAMMPS-distributed InP_JCPA2020 chemical SNAP
# model. Supply its directory with `-var potential_dir /path/to/potentials`.

units metal
atom_style atomic
boundary p p p

lattice diamond 5.87
region simulation_box block 0 3 0 3 0 3 units lattice
create_box 2 simulation_box
create_atoms 1 box basis 5 2 basis 6 2 basis 7 2 basis 8 2
mass 1 114.818
mass 2 30.973761998

pair_style snap
pair_coeff * * ${potential_dir}/InP_JCPA2020.snapcoeff &
                 ${potential_dir}/InP_JCPA2020.snapparam In P

thermo 1
thermo_style custom step atoms pe
thermo_modify format float %.17g
run 0
